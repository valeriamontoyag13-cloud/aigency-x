# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local al repositorio.
# En producción, estas variables se cargan en Vercel:
# proyecto aigency-x → Settings → Environments → Production.

# URL del webhook de n8n que recibe cada formulario (nodo "Webhook", método POST).
# Usa la "Production URL" del nodo, no la de prueba.
# Workflow en n8n: "🌐 Web AIgency.X — Nuevo cliente (Airtable + Gmail)".
N8N_LEAD_WEBHOOK_URL=

# Clave secreta. La página la envía en el encabezado "X-Webhook-Secret" y el
# webhook de n8n rechaza (403) las peticiones que no la traen, así que sin ella
# los formularios no llegan. Tiene que ser igual a la credencial
# "Webhook Web AIgency.X (header secreto)" en n8n.
N8N_WEBHOOK_SECRET=

# ── Conectar WhatsApp de un cliente (página /es/conectar, Embedded Signup de Meta) ──
# App de producción "AIgency.X" (público: va en el navegador).
NEXT_PUBLIC_META_APP_ID=1578603767347524
# ID de configuración de Embedded Signup (App Dashboard → Facebook Login for Business → Configurations).
# Mientras esté vacío, la página muestra "todavía no está disponible".
NEXT_PUBLIC_META_ES_CONFIG_ID=
# Opcional: si está vacía se usa el mismo servidor de N8N_LEAD_WEBHOOK_URL con la ruta /webhook/aigencyx-conectar-whatsapp.
# "Production URL" del webhook del workflow "AIgency.X | Onboarding · Conectar WhatsApp de un negocio".
# Usa la misma clave N8N_WEBHOOK_SECRET de arriba.
N8N_ONBOARDING_WEBHOOK_URL=

# ── Formulario de alta de un cliente (página /es/alta) ──
# Opcional: si está vacía se usa el mismo servidor de N8N_LEAD_WEBHOOK_URL con la ruta /webhook/aigencyx-alta-negocio.
# "Production URL" del webhook del workflow "AIgency.X | Onboarding · Datos del negocio (formulario de alta)".
# Usa la misma clave N8N_WEBHOOK_SECRET de arriba.
N8N_ALTA_WEBHOOK_URL=
