# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local al repositorio.
# En producción, estas variables se cargan en Vercel:
# proyecto aigency-x → Settings → Environments → Production.

# URL del webhook de n8n que recibe cada formulario (nodo "Webhook", método POST).
# Usa la "Production URL" del nodo, no la de prueba.
# Workflow en n8n: "🌐 Web AIgency.X — Nuevo cliente (Airtable + Gmail)".
N8N_LEAD_WEBHOOK_URL=

# Clave secreta. La página la envía en el encabezado "X-Webhook-Secret" y el
# webhook de n8n rechaza (403) las peticiones que no la traen, así que sin ella
# los formularios no llegan. Tiene que ser igual a la credencial
# "Webhook Web AIgency.X (header secreto)" en n8n.
N8N_WEBHOOK_SECRET=
